<?xml version="1.0" encoding="utf-8"?>
<!-- Tablets and unfolded foldables: larger icons and wider margins rather than more, smaller
     columns. Stretching phone density across a 7-inch pane is what makes an app look ported.
     Note this is a floor, not the whole responsive strategy — the grid and the home layout both
     measure their actual width at runtime, which is what handles a live fold. -->
<resources>
    <dimen name="df_screen_margin">32dp</dimen>
    <dimen name="df_hero_height">300dp</dimen>
    <dimen name="df_collection_card_width">176dp</dimen>
    <dimen name="df_grid_cell_target">116dp</dimen>
    <dimen name="df_icon_size">64dp</dimen>
    <dimen name="df_gutter">16dp</dimen>
</resources>
