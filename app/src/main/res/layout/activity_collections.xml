<?xml version="1.0" encoding="utf-8"?>
<!--
  All six collections at once, in as many columns as the screen can hold.

  Fixed header, scrolling grid: the same shape as the browser, so the two screens behave the same
  way rather than each inventing its own.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/df_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/collections_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/df_screen_margin"
        android:paddingEnd="@dimen/df_screen_margin"
        android:paddingTop="@dimen/df_space_5"
        android:paddingBottom="@dimen/df_space_3">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collections_title"
            style="@style/DF.Text.Display" />

        <TextView
            android:id="@+id/collections_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_1"
            style="@style/DF.Text.Caption" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/collections_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/df_screen_margin"
        android:paddingEnd="@dimen/df_screen_margin"
        android:paddingBottom="@dimen/df_space_6"
        android:scrollbars="vertical" />
</LinearLayout>
