<?xml version="1.0" encoding="utf-8"?>
<!--
  A widget, inside a labelled card.

  The frame has no background of its own: the widget brings the collection's surface with it, and a
  card behind a card is the "excessive cards" look. The plate under it is just the standard section
  card the rest of the app uses.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/df_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/df_space_4"
    android:paddingEnd="@dimen/df_space_4"
    android:paddingTop="@dimen/df_space_4"
    android:paddingBottom="@dimen/df_space_4">

    <TextView
        android:id="@+id/widget_preview_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DF.Text.Subtitle" />

    <TextView
        android:id="@+id/widget_preview_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/df_space_1"
        style="@style/DF.Text.Caption" />

    <LinearLayout
        android:id="@+id/widget_preview_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/df_space_4"
        android:gravity="center"
        android:orientation="horizontal" />
</LinearLayout>
