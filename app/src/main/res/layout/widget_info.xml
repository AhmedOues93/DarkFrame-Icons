<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal info: time, date and charge on one line.

  The time and date keep themselves current; only the charge figure comes from the provider, on the
  same real power events the battery widget uses. Nothing here polls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_noir"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextClock
        android:id="@+id/widget_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#F2F1EE"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/widget_tertiary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:includeFontPadding="false"
            android:textColor="#B0F2F1EE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#B0F2F1EE"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
