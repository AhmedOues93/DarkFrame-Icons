<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/df_space_1">

    <ImageView
        android:id="@+id/wallpaper_image"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/df_preview_clip"
        android:scaleType="centerCrop"
        tools:ignore="ContentDescription"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/df_space_2">

        <TextView
            android:id="@+id/wallpaper_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            style="@style/DF.Text.Caption"/>

        <TextView
            android:id="@+id/wallpaper_tier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/df_pill_pro"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/tier_pro"
            android:textColor="@color/df_pro"
            android:visibility="gone"
            style="@style/DF.Text.Label"/>
    </LinearLayout>
</LinearLayout>
