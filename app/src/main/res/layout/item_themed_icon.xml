<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="14dp">

    <!-- contentDescription is set per row at bind time from the app's label, which is the only
         place the correct text is known. -->
    <ImageView
        android:id="@+id/icon_image"
        android:layout_width="@dimen/df_icon_size"
        android:layout_height="@dimen/df_icon_size"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/icon_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/df_text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/icon_curated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/browser_curated_badge"
        android:textColor="@color/df_text_tertiary"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
