<?xml version="1.0" encoding="utf-8"?>
<!--
  Every app DarkFrame can theme, in the collection the user is looking at.

  The header is fixed and the grid scrolls under it, so the collection chips and the search field
  stay reachable in a list that can be several hundred apps long. Everything takes its size and
  colour from the design system: the previous version set a text size on every view, which is how a
  screen ends up looking approximately right and nowhere consistent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/df_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/browser_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/df_screen_margin"
        android:paddingEnd="@dimen/df_screen_margin"
        android:paddingTop="@dimen/df_space_5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/browser_title"
                    style="@style/DF.Text.Display" />

                <TextView
                    android:id="@+id/browser_coverage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/df_space_1"
                    style="@style/DF.Text.Caption" />
            </LinearLayout>

            <!-- The apply help used to be a full-width bar pinned to the bottom of the screen,
                 which gave a secondary link the most prominent position on the page. -->
            <TextView
                android:id="@+id/browser_setup_link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/df_pill"
                android:minHeight="40dp"
                android:gravity="center"
                android:paddingStart="@dimen/df_space_4"
                android:paddingEnd="@dimen/df_space_4"
                android:text="@string/browser_apply_chip"
                style="@style/DF.Text.Label" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_4"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/collection_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Search is a card like every other control, with its own clear button: a bare EditText
             on a flat fill was the last piece of default Android chrome on this screen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_3"
            android:background="@drawable/df_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/df_space_4"
            android:paddingEnd="@dimen/df_space_2">

            <EditText
                android:id="@+id/browser_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@null"
                android:hint="@string/browser_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:minHeight="48dp"
                android:textColor="@color/df_text_primary"
                android:textColorHint="@color/df_text_tertiary"
                style="@style/DF.Text.Body" />

            <TextView
                android:id="@+id/browser_search_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/df_pill"
                android:contentDescription="@string/browser_search_clear"
                android:minWidth="40dp"
                android:minHeight="32dp"
                android:gravity="center"
                android:text="@string/browser_search_clear_glyph"
                android:visibility="gone"
                style="@style/DF.Text.Label" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/icon_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/df_space_3"
            android:paddingEnd="@dimen/df_space_3"
            android:paddingTop="@dimen/df_space_3"
            android:paddingBottom="@dimen/df_space_6"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/browser_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/df_space_6"
            android:visibility="gone"
            style="@style/DF.Text.Body" />
    </FrameLayout>
</LinearLayout>
