<?xml version="1.0" encoding="utf-8"?>
<!--
  A numbered step in a flow that has more than one.

  The number is the whole point of this layout existing: two cards that look alike read as two
  options, and on the Samsung screen they are a sequence — preparing the icons, then handing them to
  the app that can apply them. Numbering them is what stops the second one looking like an
  alternative to the first.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/df_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/df_space_4"
    android:paddingEnd="@dimen/df_space_4"
    android:paddingTop="@dimen/df_space_4"
    android:paddingBottom="@dimen/df_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/step_number"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/df_pill"
            android:gravity="center"
            style="@style/DF.Text.Label" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/df_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/step_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/DF.Text.Subtitle" />

            <TextView
                android:id="@+id/step_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/df_space_1"
                style="@style/DF.Text.Body" />

            <TextView
                android:id="@+id/step_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/df_space_2"
                android:visibility="gone"
                style="@style/DF.Text.Caption" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/step_action"
        android:layout_width="match_parent"
        android:layout_height="@dimen/df_control_height"
        android:layout_marginTop="@dimen/df_space_4"
        style="@style/DF.Button.Primary" />
</LinearLayout>
