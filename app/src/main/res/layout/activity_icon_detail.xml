<?xml version="1.0" encoding="utf-8"?>
<!--
  One app, up close: the preview first, then the six collections, then the actions.

  Order is the design. A stack of verbs above a thumbnail is what the old dialog was, and it made
  the user choose before they could see what they were choosing between.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detail_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/df_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/df_space_6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/df_screen_margin"
        android:paddingEnd="@dimen/df_screen_margin"
        android:paddingTop="@dimen/df_space_5">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/DF.Text.Display" />

        <TextView
            android:id="@+id/detail_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_1"
            style="@style/DF.Text.Caption" />

        <!-- The preview sits on a raised plate rather than on the page, so a near-black icon still
             has an edge to read against. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_5"
            android:background="@drawable/df_card_raised"
            android:paddingTop="@dimen/df_space_6"
            android:paddingBottom="@dimen/df_space_6">

            <ImageView
                android:id="@+id/detail_preview"
                android:layout_width="@dimen/df_detail_preview_max"
                android:layout_height="@dimen/df_detail_preview_max"
                android:layout_gravity="center"
                android:background="@drawable/df_preview_clip"
                android:contentDescription="@string/detail_preview_description"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/detail_collection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_4"
            style="@style/DF.Text.Title" />

        <TextView
            android:id="@+id/detail_collection_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_1"
            style="@style/DF.Text.Body" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/detail_swatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_4"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/detail_favourite"
            android:layout_width="match_parent"
            android:layout_height="@dimen/df_control_height"
            android:layout_marginTop="@dimen/df_space_5"
            style="@style/DF.Button.Secondary" />

        <TextView
            android:id="@+id/detail_export"
            android:layout_width="match_parent"
            android:layout_height="@dimen/df_control_height"
            android:layout_marginTop="@dimen/df_space_2"
            android:text="@string/detail_export"
            style="@style/DF.Button.Secondary" />

        <TextView
            android:id="@+id/detail_shortcut"
            android:layout_width="match_parent"
            android:layout_height="@dimen/df_control_height"
            android:layout_marginTop="@dimen/df_space_2"
            android:text="@string/detail_shortcut"
            android:visibility="gone"
            style="@style/DF.Button.Secondary" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
