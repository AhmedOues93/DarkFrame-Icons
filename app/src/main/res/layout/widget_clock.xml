<?xml version="1.0" encoding="utf-8"?>
<!-- TextClock keeps itself up to date in the launcher's process, so this widget costs DarkFrame no
     background work at all: no service, no alarm, no periodic update. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_noir"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextClock
        android:id="@+id/widget_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#F2F1EE"
        android:textSize="32sp"/>

    <TextClock
        android:id="@+id/widget_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:includeFontPadding="false"
        android:textColor="#B0F2F1EE"
        android:textSize="12sp"/>
</LinearLayout>
