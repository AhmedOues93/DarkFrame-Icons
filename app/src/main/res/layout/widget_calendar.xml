<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar: the month, today's number, and the weekday — and a tap that opens the user's calendar.
  Three TextClocks, so it rolls over at midnight in the launcher's process with no alarm and no
  periodic update of any kind.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_noir"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <TextClock
        android:id="@+id/widget_tertiary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="MMMM"
        android:format24Hour="MMMM"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="#B0F2F1EE"
        android:textSize="11sp" />

    <TextClock
        android:id="@+id/widget_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:format12Hour="d"
        android:format24Hour="d"
        android:includeFontPadding="false"
        android:textColor="#F2F1EE"
        android:textSize="40sp" />

    <TextClock
        android:id="@+id/widget_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEEE"
        android:format24Hour="EEEE"
        android:includeFontPadding="false"
        android:textColor="#B0F2F1EE"
        android:textSize="13sp" />
</LinearLayout>
