<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_noir" android:padding="12dp">
    <AnalogClock android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_gravity="center" />
    <TextView android:id="@+id/widget_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" android:text="@string/widget_analog" android:textColor="#F2F1EE"
        android:textSize="10sp" />
</FrameLayout>
