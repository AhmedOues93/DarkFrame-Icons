<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/df_card_clickable"
    android:minHeight="76dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="@dimen/df_space_4"
    android:paddingTop="@dimen/df_space_3"
    android:paddingEnd="@dimen/df_space_4"
    android:paddingBottom="@dimen/df_space_3">

    <TextView
        android:id="@+id/tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        style="@style/DF.Text.Subtitle"/>

    <TextView
        android:id="@+id/tile_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        style="@style/DF.Text.Caption"/>
</LinearLayout>
