<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/simple_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/df_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/df_screen_margin"
        android:paddingTop="@dimen/df_space_5"
        android:paddingEnd="@dimen/df_screen_margin"
        android:paddingBottom="@dimen/df_space_6">

        <TextView
            android:id="@+id/simple_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/DF.Text.Display"/>

        <TextView
            android:id="@+id/simple_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_2"
            android:visibility="gone"
            style="@style/DF.Text.Body"/>

        <LinearLayout
            android:id="@+id/simple_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/df_space_4"
            android:orientation="vertical"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
