    <!-- Apply -->
    <string name="apply_title">Apply DarkFrame</string>
    <string name="apply_samsung_heading">Samsung One UI</string>
    <string name="apply_samsung_body">One UI Home does not read icon packs directly. Samsung\'s
        Theme Park applies an icon theme across your home screen and app drawer, and DarkFrame is
        ready for it as an icon pack.</string>
    <string name="apply_samsung_step_open">Open Theme Park</string>
    <string name="apply_samsung_step_goodlock">Open Good Lock</string>
    <string name="apply_samsung_step_install">Get Good Lock</string>
    <string name="apply_samsung_how">In Theme Park choose Icon, pick DarkFrame as the icon pack, then
        save and apply. Samsung performs that last step, not DarkFrame.</string>
    <string name="apply_samsung_goodlock_hint">Theme Park is a Good Lock module. Open Good Lock and
        install Theme Park, then come back.</string>
    <string name="apply_samsung_install_hint">Theme Park comes from Good Lock in the Galaxy Store.</string>
    <string name="apply_samsung_unavailable">Theme Park is not available on this device.</string>

    <!-- The two Samsung steps. Worded so step 1 is plainly something DarkFrame does and step 2 is
         plainly something Samsung does: the single-button version implied DarkFrame had already
         applied the icons, which it had not. -->
    <string name="apply_prepare_title">Create your DarkFrame icons</string>
    <string name="apply_prepare_body">DarkFrame renders every app on this device in %1$s at full
        resolution and keeps the finished set ready. This is the part DarkFrame does itself.</string>
    <string name="apply_prepare_action">Create icons</string>
    <string name="apply_prepare_again">Create them again</string>
    <string name="apply_prepare_starting">Reading your apps…</string>
    <string name="apply_prepare_progress">%1$d of %2$d</string>
    <string name="apply_prepare_done">%1$d icons ready</string>
    <string name="apply_handoff_title">Apply through Samsung Theme Park</string>
    <string name="apply_share_set">Save the whole set</string>
    <string name="apply_share_set_empty">Create your icons first.</string>
    <string name="apply_iconpack_heading">%1$s</string>
    <string name="apply_iconpack_body">Your launcher reads icon packs. Open its settings and choose
        DarkFrame as the icon pack. DarkFrame cannot make that choice for you — no launcher offers
        an API for it.</string>
    <string name="apply_open_launcher_settings">Open launcher</string>

    <string name="apply_shortcut_heading">%1$s</string>
    <string name="apply_shortcut_body">This launcher does not read icon packs. DarkFrame can add a
        themed shortcut for a single app from the app list — it sits beside the original rather than
        replacing it, so it is offered per app and never as a bulk action.</string>

    <string name="apply_export_heading">Export</string>
    <string name="apply_export_body">You can export any themed icon as a PNG from the app list and
        use it wherever your launcher or theme engine allows.</string>

    <string name="apply_limits_heading">What Android allows</string>
    <string name="apply_limits_body">No Android app can replace another app\'s icon by itself. The
        launcher decides what it draws, so DarkFrame prepares the icons and hands over to whatever
        your launcher actually supports.</string>
    <string name="apply_preview_icons">Preview your icons</string>

