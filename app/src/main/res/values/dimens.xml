<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Spacing scale. Every gap in the app is one of these. -->
    <dimen name="df_space_1">4dp</dimen>
    <dimen name="df_space_2">8dp</dimen>
    <dimen name="df_space_3">12dp</dimen>
    <dimen name="df_space_4">16dp</dimen>
    <dimen name="df_space_5">24dp</dimen>
    <dimen name="df_space_6">32dp</dimen>
    <dimen name="df_space_7">48dp</dimen>

    <!-- Radii. Three values, used by role: control, card, hero. -->
    <dimen name="df_radius_control">14dp</dimen>
    <dimen name="df_radius_card">20dp</dimen>
    <dimen name="df_radius_hero">26dp</dimen>

    <dimen name="df_screen_margin">20dp</dimen>
    <dimen name="df_control_height">58dp</dimen>
    <dimen name="df_hero_height">240dp</dimen>
    <dimen name="df_palette_height">14dp</dimen>
    <dimen name="df_collection_card_width">148dp</dimen>
    <dimen name="df_favorite_thumb">120dp</dimen>
    <!-- Target column width on the Collections screen. Wider than the home row's card, because
         this is the screen where the previews are meant to be judged rather than skimmed. -->
    <dimen name="df_collection_grid_target">200dp</dimen>

    <!-- Target width of one app-grid cell. The browser derives its column count from the measured
         width divided by this, so one layout serves phones, a Fold's cover and inner screens, and
         tablets without a separate layout per form factor. -->
    <!-- Widget preview plates, matching the providers' own targetCellWidth/Height so a widget
         that is four cells by one looks four-by-one on the Widgets screen too. -->
    <dimen name="df_widget_preview_square">128dp</dimen>
    <dimen name="df_widget_preview_wide">220dp</dimen>
    <dimen name="df_widget_preview_short">76dp</dimen>
    <dimen name="df_grid_cell_target">96dp</dimen>
    <!-- Icon detail: the swatch strip cell, and the ceiling on the large preview. The preview
         is sized from the window so it grows on a Fold's inner screen, but past this it would
         only be a larger upscale of the same bucketed render. -->
    <dimen name="df_swatch_icon">44dp</dimen>
    <dimen name="df_detail_preview_max">200dp</dimen>
    <!-- Floor and ceiling for a grid icon. The size itself comes from the measured column
         width; these only stop a very narrow or very wide column producing something silly. -->
    <dimen name="df_icon_size">56dp</dimen>
    <dimen name="df_icon_size_max">88dp</dimen>
    <dimen name="df_gutter">12dp</dimen>
</resources>
