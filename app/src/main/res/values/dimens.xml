<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Target width of one grid cell. The browser derives its column count from the measured
         width divided by this, which is what makes one layout work on a phone, an unfolded Fold
         and a tablet without a separate layout per form factor. -->
    <dimen name="df_grid_cell_target">96dp</dimen>
    <dimen name="df_icon_size">60dp</dimen>
    <dimen name="df_screen_margin">16dp</dimen>
    <dimen name="df_gutter">12dp</dimen>
</resources>
