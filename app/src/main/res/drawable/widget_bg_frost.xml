<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface for the frost collection. Same container colour, keyline and corner geometry as
     the icons, so a widget sits with them instead of beside them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFF2F1ED"/>
    <corners android:radius="22dp"/>
    <stroke android:width="1dp" android:color="#1A101114"/>
</shape>
