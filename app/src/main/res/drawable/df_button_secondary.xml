<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/df_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/df_radius_control"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/df_surface_raised"/>
            <corners android:radius="@dimen/df_radius_control"/>
            <stroke android:width="1dp" android:color="@color/df_hairline"/>
        </shape>
    </item>
</ripple>
