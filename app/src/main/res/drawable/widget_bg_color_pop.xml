<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface for the color_pop collection. Same container colour, keyline and corner geometry as
     the icons, so a widget sits with them instead of beside them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF17191D"/>
    <corners android:radius="22dp"/>
    <stroke android:width="1dp" android:color="#14FFFFFF"/>
</shape>
