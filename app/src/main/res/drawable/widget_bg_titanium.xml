<?xml version="1.0" encoding="utf-8"?>
<!-- Widget surface for the titanium collection. Same container colour, keyline and corner geometry as
     the icons, so a widget sits with them instead of beside them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FF2A2D32"/>
    <corners android:radius="22dp"/>
    <stroke android:width="1dp" android:color="#26E8EAEE"/>
</shape>
