<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface. Separation comes from the fill against the page, plus a hairline that is barely
     there — not from a visible border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/df_surface"/>
    <corners android:radius="@dimen/df_radius_card"/>
    <stroke android:width="1dp" android:color="@color/df_hairline"/>
</shape>
