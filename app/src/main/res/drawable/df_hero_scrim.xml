<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim so the look's name stays readable over any wallpaper, including the light ones.
     Clipped to the card radius by the parent's background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#D9000000"
        android:centerColor="#59000000"
        android:endColor="#00000000"
        android:type="linear"/>
    <corners android:radius="@dimen/df_radius_card"/>
</shape>
