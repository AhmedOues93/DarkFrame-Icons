<?xml version="1.0" encoding="utf-8"?>
<!-- Page indicator. The unselected state is dim rather than hollow: an outlined circle at this size
     is mostly outline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/df_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/df_text_tertiary" />
        </shape>
    </item>
</selector>
