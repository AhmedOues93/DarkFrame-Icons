<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility.

      Android 11+ hides installed packages unless an app declares what it needs to see. DarkFrame
      declares the narrowest set that answers the questions it has to ask:

        1. ACTION_MAIN + CATEGORY_LAUNCHER — the apps that have a launcher icon. This is the entire
           subject of the product, and it is self-limiting: apps with no launcher entry, background
           services and content providers stay invisible to DarkFrame.
        2. ACTION_MAIN + CATEGORY_HOME — the home launchers, so DarkFrame can tell which launcher is
           active and therefore which apply mechanism genuinely exists on this device.
        3. Four named Samsung packages, so the Samsung flow can tell whether Theme Park or Good Lock
           is installed and offer the right step instead of guessing.

      QUERY_ALL_PACKAGES is deliberately NOT requested. It is broader than this feature needs, and
      Google Play restricts it to a narrow set of use cases that icon customisation is not among, so
      requesting it would risk the listing while adding no capability. See docs/PACKAGE_VISIBILITY.md.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.samsung.android.themedesigner" />
        <package android:name="com.samsung.app.goodlock" />
        <package android:name="com.samsung.android.goodlock" />
        <package android:name="com.sec.android.app.samsungapps" />
    </queries>

    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Fold and large-screen support: DarkFrame resizes rather than letterboxing, and its grids
         derive their column count from the measured width at runtime. -->
    <supports-screens
        android:largeScreens="true"
        android:normalScreens="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.DarkFrame">

        <activity
            android:name=".MainActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="true"
            android:theme="@style/Theme.DarkFrame.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Icon-pack discovery.

              These are the de facto intent actions third-party launchers scan for to find installed
              icon packs; declaring them is what makes DarkFrame appear in Nova's, Lawnchair's and
              Smart Launcher's icon-pack lists, and what lets Samsung's Theme Park list DarkFrame as
              an icon pack to build a theme from. The consumer then reads res/xml/appfilter.xml.

              This mechanism carries curated tiles only, and does nothing on Pixel Launcher. See
              docs/LAUNCHER_SUPPORT.md.
            -->
            <intent-filter>
                <action android:name="org.adw.launcher.THEMES" />
                <action android:name="com.novalauncher.THEME" />
                <action android:name="com.gau.go.launcherex.theme" />
                <action android:name="ch.deletescape.lawnchair.ICONPACK" />
                <action android:name="app.lawnchair.icons.THEMED_ICON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="org.adw.launcher.theme.ICON_PACK"
                android:value="@string/app_name" />
        </activity>

        <activity
            android:name=".ui.OnboardingActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.setup.ApplyActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.look.LookDetailActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.browser.IconBrowserActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".wallpaper.WallpaperActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.WidgetsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.FavoritesActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.SettingsActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />
        <activity
            android:name=".ui.ProActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density"
            android:exported="false" />

        <receiver android:name=".widget.DarkFrameDateWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/date_widget_info" />
        </receiver>
        <receiver android:name=".widget.DarkFrameClockWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>
        <!-- The four power actions are system broadcasts that are still delivered to manifest
             receivers, which is how the battery widget stays current without polling. -->
        <receiver android:name=".widget.DarkFrameBatteryWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/battery_widget_info" />
        </receiver>

        <!-- Shares exported icon PNGs. Scoped by res/xml/file_paths.xml to one cache subdirectory,
             and grants are per-URI and read-only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
